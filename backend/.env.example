APP_NAME=Rokn
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PUBLIC_WEB_URL=https://rokn.app
# Channels that must have an active valid update row before launch readiness
# passes. During direct APK testing use direct. At store launch use
# play,direct,appstore as applicable.
MOBILE_RELEASE_REQUIRED_CHANNELS=direct
# Raise these only after an actionable forced-update release is active.
MOBILE_API_REQUIRED_CAPABILITIES=
APP_TRUSTED_HOSTS=

# Universal/App Links. Use the SHA-256 fingerprints of every Play signing
# certificate that may install com.rokn, comma separated. Apple values use
# TEAM_ID.bundle_id, for example ABC1234567.com.rokn.
APP_LINK_ANDROID_PACKAGE=com.rokn
APP_LINK_ANDROID_SHA256_FINGERPRINTS=
APP_LINK_APPLE_APP_IDS=
SESSION_SECURE_COOKIE=false
# Production fixed origin: exact reverse-proxy IPs/CIDRs. A managed private
# origin with rotating edges may use * only with the explicit flag below.
TRUSTED_PROXIES=
TRUSTED_PROXIES_ALLOW_DYNAMIC_EDGE=false
COURSE_ATTACHMENT_SIGNED_URL_MINUTES=30
PAYMENT_EVIDENCE_DISK=local
# Paid-course PDFs must use a private disk shared by every API node. For an
# S3-compatible disk set COURSE_PDF_DISK=s3. For a mounted shared filesystem,
# keep course-pdfs, set an absolute mount path and attest that it is shared.
COURSE_PDF_DISK=course-pdfs
COURSE_PDF_STORAGE_PATH=
COURSE_PDF_SHARED_STORAGE=false
# Feedback screenshots are private and must survive deploys on every API node.
# Point this to a mounted shared directory and attest it explicitly.
FEEDBACK_STORAGE_PATH=
FEEDBACK_SHARED_STORAGE=false
APP_DOMAIN=localhost
APP_TIMEZONE=UTC
BUSINESS_TIMEZONE=Africa/Cairo
DB_TIMEZONE=+00:00

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel Nightwatch stays off locally until an environment token is supplied.
NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1
NIGHTWATCH_COMMAND_SAMPLE_RATE=1.0
NIGHTWATCH_SCHEDULED_TASK_SAMPLE_RATE=1.0
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0

API_READ_IDENTITY_PER_MINUTE=240
API_READ_IP_PER_MINUTE=1200
API_WRITE_IDENTITY_PER_MINUTE=90
API_WRITE_IP_PER_MINUTE=450

# Operational feature controls. Runtime overrides are written audibly with
# `php artisan product:feature`; these values are deployment defaults only.
PRODUCT_FEATURE_TTL_SECONDS=300
PRODUCT_CHECKOUT_ENABLED=true
PRODUCT_PLAYBACK_ENABLED=true
PRODUCT_PROJECT_UPLOADS_ENABLED=true
PRODUCT_AI_CHAT_ENABLED=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rokn
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
FILESYSTEM_PUBLIC_DISK=public
CERTIFICATE_DISK=public
# CERTIFICATE_FONT_PATH=/absolute/path/to/Cairo.ttf
QUEUE_CONNECTION=sync
WEBHOOK_QUEUE=webhooks
NOTIFICATIONS_QUEUE=notifications
AI_CHAT_QUEUE=ai-chat
AI_FEEDBACK_QUEUE=ai-feedback
MEDIA_QUEUE=media
OPERATIONS_QUEUE=operations
QUEUE_LONGEST_JOB_TIMEOUT_SECONDS=300
QUEUE_RETRY_HEADROOM_SECONDS=30
QUEUE_HEARTBEAT_REQUIRED_QUEUES=default,notifications,ai-chat,ai-feedback,media,operations,webhooks
QUEUE_BACKLOG_DEFAULT_LIMIT=1000
QUEUE_BACKLOG_NOTIFICATIONS_LIMIT=5000
QUEUE_BACKLOG_AI_CHAT_LIMIT=200
QUEUE_BACKLOG_AI_FEEDBACK_LIMIT=200
QUEUE_BACKLOG_MEDIA_LIMIT=500
QUEUE_BACKLOG_OPERATIONS_LIMIT=500
QUEUE_BACKLOG_WEBHOOKS_LIMIT=500
SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=180
OPERATIONS_ALERT_REPEAT_MINUTES=30
FCM_CIRCUIT_FAILURE_THRESHOLD=3
FCM_CIRCUIT_OPEN_SECONDS=60
ACCOUNT_FILE_CLEANUP_MAX_ATTEMPTS=20
BUNNY_CLEANUP_MAX_ATTEMPTS=8
STORE_NOTIFICATION_STALE_MINUTES=10
PAYMENT_RECONCILIATION_STALE_MINUTES=45
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
TRANSACTIONAL_MAIL_MAILER=
TRANSACTIONAL_MAIL_HOST=
TRANSACTIONAL_MAIL_PORT=
TRANSACTIONAL_MAIL_USERNAME=
TRANSACTIONAL_MAIL_PASSWORD=
TRANSACTIONAL_MAIL_ENCRYPTION=
TRANSACTIONAL_MAIL_FROM_ADDRESS=
TRANSACTIONAL_MAIL_FROM_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Project review fallback (keeps sincere learners moving if an optional evaluator is unavailable)
PROJECT_FALLBACK_REVIEW_DELAY_SECONDS=90
PROJECT_SUBMISSION_DISK=local

# Signed disaster-recovery evidence (the dashboard never performs restores).
DISASTER_RECOVERY_MODE=false
RECOVERY_ENCRYPTION_KEY_ID=
RECOVERY_EVIDENCE_SIGNING_KEY=
BACKUP_EVIDENCE_PATH=/mnt/rokn/storage/app/recovery/latest-backup.json
RECOVERY_EVIDENCE_PATH=/mnt/rokn/storage/app/recovery/latest.json
BACKUP_MAX_AGE_HOURS=26
RESTORE_DRILL_MAX_AGE_DAYS=90
RECOVERY_RPO_MINUTES=15
RECOVERY_RTO_MINUTES=60
MYSQL_BINARY=mysql
MEDIA_RECONCILE_FETCH_MANIFEST=true
KASHIER_RECONCILE_LOCK_KEY=operations:kashier-reconcile:lock:v1
KASHIER_RECONCILE_LOCK_SECONDS=1800
PROJECT_MINIMUM_TEXT_LENGTH=10
PROJECT_MINIMUM_FILE_BYTES=512
PROJECT_MAXIMUM_FILE_KILOBYTES=25600
PROJECT_IMAGE_INSPECTION_MAX_BYTES=8388608
PROJECT_IMAGE_INSPECTION_MAX_PIXELS=12000000
PROJECT_DARK_IMAGE_THRESHOLD=12
PROJECT_DARK_IMAGE_RATIO=0.97
PROJECT_WHITE_IMAGE_THRESHOLD=248
PROJECT_WHITE_IMAGE_RATIO=0.985
PROJECT_SOLID_IMAGE_LUMINANCE_RANGE=3

# Bunny.net secrets stay on the server. Database secrets entered from the
# dashboard are encrypted; environment variables take precedence.
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
# Optional independent streaming hostname for automatic playback failover.
# Leave blank until a second Bunny pull zone/hostname has been configured.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_CDN_HOSTNAME=
BUNNY_STORAGE_TOKEN_AUTH_KEY=
BUNNY_TOKEN_AUTH_KEY=
BUNNY_STREAM_WEBHOOK_SECRET=
BUNNY_DIRECT_UPLOAD_SIGNATURE_TTL_SECONDS=86400
BUNNY_DIRECT_UPLOAD_CLAIM_TTL_HOURS=24
BUNNY_DIRECT_UPLOAD_ALLOCATION_LEASE_SECONDS=120
BUNNY_PROBE_CIRCUIT_FAILURE_THRESHOLD=3
BUNNY_PROBE_CIRCUIT_OPEN_SECONDS=60
PLAYBACK_SIGNED_URL_TTL_SECONDS=3600
PLAYBACK_REFRESH_MARGIN_SECONDS=900

# OpenRouter server-side proxy
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.6-sol
OPENROUTER_PROJECT_MODEL=openai/gpt-5.6-sol
OPENROUTER_FALLBACK_MODELS=openai/gpt-5.6-sol,openai/gpt-5.6-terra,openai/gpt-5.6-luna
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_MAX_TOKENS=800
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_CONNECT_TIMEOUT_SECONDS=5
OPENROUTER_PROVIDER_SORT=latency
OPENROUTER_PROVIDER_DATA_COLLECTION=allow
OPENROUTER_PROVIDER_ZDR=false
OPENROUTER_WEB_SEARCH_ENABLED=true
OPENROUTER_WEB_SEARCH_MAX_RESULTS=3
OPENROUTER_WEB_SEARCH_MAX_TOTAL_RESULTS=5
OPENROUTER_CIRCUIT_FAILURE_THRESHOLD=3
OPENROUTER_CIRCUIT_OPEN_SECONDS=30
OPENROUTER_BILLING_CIRCUIT_OPEN_SECONDS=900
OPENROUTER_GLOBAL_DAILY_REQUEST_LIMIT=5000
OPENROUTER_GLOBAL_DAILY_TOKEN_BUDGET=2100000
OPENROUTER_GLOBAL_MONTHLY_TOKEN_BUDGET=50000000
OPENROUTER_CHAT_HISTORY_DAYS=90
OPENROUTER_PDF_PARSER_ENGINE=cloudflare-ai
OPENROUTER_ATTACHMENT_PROVIDER_MAX_BYTES=8388608
OPENROUTER_QUEUE_STALE_SECONDS=60
OPENROUTER_RESPONSE_RECOVERY_CACHE_TTL_SECONDS=900
# Optional comma-separated allowlist. Empty keeps the model selected in the dashboard.
OPENROUTER_ALLOWED_MODELS=openai/gpt-5.6-sol,openai/gpt-5.6-terra,openai/gpt-5.6-luna
# Net value of one purchased coin after payment fees/tax, expressed in USD.
# Finance updates this when packages or FX change; it drives plan suggestions only.
ROKN_NET_USD_PER_PAID_COIN=0.001
ROKN_AI_COST_SAFETY_MULTIPLIER=2.0
ROKN_AI_RESERVATION_TTL_SECONDS=1200
ROKN_AI_UNANSWERED_PROVIDER_REQUEST_LIMIT=4
ROKN_AI_UNANSWERED_PROVIDER_WINDOW_SECONDS=600
ROKN_AI_PROVIDER_EXPOSURE_COOLDOWN_SECONDS=300

# Social sign-in is verified server-side. TikTok Login Kit sends its access token here.
SOCIAL_AUTH_TIMEOUT_SECONDS=10
SOCIAL_AUTH_PROVIDERS=google,tiktok,facebook,apple
SOCIAL_AUTH_RECOMMENDED_PROVIDER=google
ACCOUNT_DELETION_REAUTH_SECONDS=300
# Generate a long random server-side value and keep it stable across APP_KEY rotation.
REWARD_TOMBSTONE_HMAC_KEY=
# Exact public API prefix used to build start/callback URLs, with no trailing slash.
# Example: https://api.rokn.com/api/v1
SOCIAL_AUTH_PUBLIC_API_URL=
SOCIAL_AUTH_RETURN_URLS=rokn://auth
TIKTOK_USER_INFO_URL=https://open.tiktokapis.com/v2/user/info/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CONNECT_TIMEOUT_SECONDS=3
GOOGLE_TIMEOUT_SECONDS=8
GOOGLE_MAPS_BROWSER_KEY=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Set this explicitly after checking Meta's currently supported Graph API version.
FACEBOOK_GRAPH_VERSION=
WELCOME_BONUS_COINS=20

# Firebase Admin service account used only by the server to deliver opted-in
# push notifications. Do not commit the JSON file itself.
FIREBASE_CREDENTIALS=
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_DATABASE_URL=

# Kashier external checkout. Select one mode explicitly and configure the
# matching pair only. Production must use `live`; never ship with `test`.
KASHIER_MODE=live
KASHIER_LIVE_API_KEY=
KASHIER_LIVE_SECRET_KEY=
KASHIER_LIVE_MID=
KASHIER_TEST_API_KEY=
KASHIER_TEST_SECRET_KEY=
KASHIER_TEST_MID=

# Native store billing. Product identifiers are controlled per coin package
# from the dashboard; the secrets below are server-only verification keys.
STORE_BILLING_ACCOUNT_BINDING_KEY=
STORE_BILLING_CONNECT_TIMEOUT_SECONDS=3
STORE_BILLING_TIMEOUT_SECONDS=12
GOOGLE_PLAY_PACKAGE_NAME=com.rokn
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_SERVICE_ACCOUNT_BASE64=
# Exact Pub/Sub push audience and OIDC service account configured in Google Cloud.
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
APPLE_STORE_BUNDLE_ID=com.rokn
APPLE_STORE_ISSUER_ID=
APPLE_STORE_KEY_ID=
APPLE_STORE_PRIVATE_KEY_FILE=
APPLE_STORE_PRIVATE_KEY_BASE64=
# Optional comma-separated override during an Apple PKI root rotation. The
# current Apple Root CA - G3 fingerprint is pinned in config by default.
APPLE_STORE_ROOT_CERTIFICATE_SHA256=

# WhatsApp API (Whatspie)
WHATSPIE_API_URL=your_api_url
WHATSPIE_API_KEY=your_api_key
WHATSPIE_DEVICE=your_device
WHATSPIE_CONNECT_TIMEOUT_SECONDS=5
WHATSPIE_TIMEOUT_SECONDS=15
# International digits only. This is the account that receives link messages.
WHATSAPP_BOT_PHONE=
# Shared only with the inbound WhatsApp webhook provider.
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_LINK_TOKEN_MINUTES=30
APPLE_CLIENT_ID=
LEARNING_MINIMUM_VERIFIED_SECONDS=20
LEARNING_REQUIRED_WATCH_FRACTION=0.80
LEARNING_MAXIMUM_PLAYBACK_RATE=2.0
LEARNING_MAXIMUM_HEARTBEAT_GAP_SECONDS=45

# Server error monitoring. Leave the DSN empty to keep reporting disabled.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=${APP_ENV}
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.0
