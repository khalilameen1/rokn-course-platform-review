APP_NAME=Rokn
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
PUBLIC_WEB_URL=https://rokn.app
APP_DOMAIN=example.com
APP_TIMEZONE=UTC
BUSINESS_TIMEZONE=Africa/Cairo
DB_TIMEZONE=+00:00
APP_TRUSTED_HOSTS=
# Android App Links: comma-separate every SHA-256 signing-certificate
# fingerprint that can install this package (Play App Signing included).
APP_LINK_ANDROID_PACKAGE=com.rokn
# Keep every signing identity that must open production links. The first value
# is the legacy release identity; the second signs the current direct APK.
APP_LINK_ANDROID_SHA256_FINGERPRINTS=01:97:0F:4D:0A:A5:9B:F4:D8:F4:DE:FB:CA:7C:B8:77:34:6D:69:BF:B7:15:A5:B6:4F:A6:DC:D2:73:3F:89:3D,C7:A7:66:4E:82:80:71:25:7F:2C:AE:C5:BD:15:D3:B7:F6:75:A3:A1:50:B1:9E:66:C8:76:7D:ED:2B:4E:B3:63
# Apple Universal Links: comma-separate TEAM_ID.bundle_id values.
APP_LINK_APPLE_APP_IDS=
# Enable only channels being released now. direct requires Kashier; play and
# appstore additionally require their own products, verification and links.
MOBILE_RELEASE_REQUIRED_CHANNELS=direct
SESSION_SECURE_COOKIE=true
# Fixed origin: exact Nginx/LB egress IPs or narrow CIDRs and leave the second
# flag false. Laravel Cloud/private rotating edge: use * and explicitly set
# the second flag true. Never use that pair on a directly reachable origin.
TRUSTED_PROXIES=*
TRUSTED_PROXIES_ALLOW_DYNAMIC_EDGE=true
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Enable only after the Nightwatch environment token is configured in the
# deployment secret store and the long-running agent/integration is active.
NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1
NIGHTWATCH_COMMAND_SAMPLE_RATE=1.0
NIGHTWATCH_SCHEDULED_TASK_SAMPLE_RATE=1.0
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0

# Backend exception reporting. Keep the DSN in the deployment secret store.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

API_READ_IDENTITY_PER_MINUTE=240
API_READ_IP_PER_MINUTE=1200
API_WRITE_IDENTITY_PER_MINUTE=90
API_WRITE_IP_PER_MINUTE=450

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Every web and worker node must use the same Redis service.
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=cache
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=360
WEBHOOK_QUEUE=webhooks
NOTIFICATIONS_QUEUE=notifications
AI_CHAT_QUEUE=ai-chat
AI_FEEDBACK_QUEUE=ai-feedback
MEDIA_QUEUE=media
OPERATIONS_QUEUE=operations
QUEUE_LONGEST_JOB_TIMEOUT_SECONDS=300
QUEUE_RETRY_HEADROOM_SECONDS=30
QUEUE_HEARTBEAT_REQUIRED_QUEUES=default,notifications,ai-chat,ai-feedback,media,operations,webhooks
QUEUE_BACKLOG_DEFAULT_LIMIT=1000
QUEUE_BACKLOG_NOTIFICATIONS_LIMIT=5000
QUEUE_BACKLOG_AI_CHAT_LIMIT=200
QUEUE_BACKLOG_AI_FEEDBACK_LIMIT=200
QUEUE_BACKLOG_MEDIA_LIMIT=500
QUEUE_BACKLOG_OPERATIONS_LIMIT=500
QUEUE_BACKLOG_WEBHOOKS_LIMIT=500
SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=180
OPERATIONS_ALERT_REPEAT_MINUTES=30
FCM_CIRCUIT_FAILURE_THRESHOLD=3
FCM_CIRCUIT_OPEN_SECONDS=60
ACCOUNT_FILE_CLEANUP_MAX_ATTEMPTS=20
BUNNY_CLEANUP_MAX_ATTEMPTS=8
STORE_NOTIFICATION_STALE_MINUTES=10
PAYMENT_RECONCILIATION_STALE_MINUTES=45

# Durable uploads use Laravel Cloud object storage. Local paths are only
# development/single-node fallbacks and must not be selected in Cloud.
PUBLIC_STORAGE_DRIVER=s3
PUBLIC_STORAGE_PREFIX=public
# Public assets require their own platform-public R2 bucket. Never reuse the
# private AWS_BUCKET: Laravel Cloud R2 does not support per-object ACLs.
PUBLIC_AWS_ACCESS_KEY_ID=
PUBLIC_AWS_SECRET_ACCESS_KEY=
PUBLIC_AWS_DEFAULT_REGION=
PUBLIC_AWS_BUCKET=
# Public delivery base (custom domain or platform public-bucket URL), not the
# S3 API endpoint. Do not include credentials, a query string or a fragment.
PUBLIC_AWS_URL=
# S3-compatible Laravel Cloud/R2 API endpoint used for writes.
PUBLIC_AWS_ENDPOINT=
PUBLIC_AWS_USE_PATH_STYLE_ENDPOINT=false
COURSE_ATTACHMENT_SIGNED_URL_MINUTES=30
SECURITY_QUARANTINE_STORAGE_DRIVER=s3
SECURITY_QUARANTINE_STORAGE_PREFIX=security-quarantine
FILESYSTEM_DRIVER=local
FILESYSTEM_PUBLIC_DISK=public
FILESYSTEM_CLOUD=s3
PAYMENT_EVIDENCE_DISK=s3
PROJECT_SUBMISSION_DISK=s3
CERTIFICATE_DISK=s3
# Paid course PDFs default to the same private shared object store. If the
# deployment deliberately uses the `course-pdfs` local driver instead, supply
# an absolute shared mount path below and change SHARED_STORAGE to true only
# after every API/worker node mounts and verifies that same durable location.
COURSE_PDF_DISK=s3
COURSE_PDF_STORAGE_PATH=
COURSE_PDF_SHARED_STORAGE=false
FEEDBACK_STORAGE_DRIVER=s3
FEEDBACK_STORAGE_PREFIX=feedback
FEEDBACK_SHARED_STORAGE=false

# Disaster recovery. Keep the signing key outside the database backup and
# preserve both APP_KEY and its opaque key identifier across a restore.
DISASTER_RECOVERY_MODE=false
RECOVERY_ENCRYPTION_KEY_ID=
RECOVERY_EVIDENCE_SIGNING_KEY=
RECOVERY_EVIDENCE_DISK=s3
BACKUP_EVIDENCE_PATH=recovery/latest-backup.json
RECOVERY_EVIDENCE_PATH=recovery/latest.json
BACKUP_MAX_AGE_HOURS=26
RESTORE_DRILL_MAX_AGE_DAYS=90
RECOVERY_RPO_MINUTES=15
RECOVERY_RTO_MINUTES=60
MYSQL_BINARY=mysql
MEDIA_RECONCILE_FETCH_MANIFEST=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_CDN_HOSTNAME=
BUNNY_STORAGE_TOKEN_AUTH_KEY=
BUNNY_TOKEN_AUTH_KEY=
# Required in production. Playback fails closed when this signing key is blank.
BUNNY_STREAM_WEBHOOK_SECRET=
# Optional Stream Read-Only API key. Configure the library webhook to
# https://your-domain/api/integrations/bunny/stream when supplied.
BUNNY_CONNECT_TIMEOUT_SECONDS=15
BUNNY_UPLOAD_TIMEOUT_SECONDS=3600
BUNNY_DIRECT_UPLOAD_SIGNATURE_TTL_SECONDS=1800
BUNNY_DIRECT_UPLOAD_CLAIM_TTL_HOURS=24
BUNNY_PROBE_CIRCUIT_FAILURE_THRESHOLD=3
BUNNY_PROBE_CIRCUIT_OPEN_SECONDS=60
PLAYBACK_SIGNED_URL_TTL_SECONDS=3600
PLAYBACK_REFRESH_MARGIN_SECONDS=900

KASHIER_MODE=live
KASHIER_LIVE_API_KEY=
KASHIER_LIVE_SECRET_KEY=
KASHIER_LIVE_MID=

# Required only when `play` is in MOBILE_RELEASE_REQUIRED_CHANNELS.
GOOGLE_PLAY_PACKAGE_NAME=com.rokn
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_SERVICE_ACCOUNT_BASE64=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
# Required only when `appstore` is in MOBILE_RELEASE_REQUIRED_CHANNELS.
APPLE_STORE_BUNDLE_ID=com.rokn
APPLE_STORE_ISSUER_ID=
APPLE_STORE_KEY_ID=
APPLE_STORE_PRIVATE_KEY_FILE=
APPLE_STORE_PRIVATE_KEY_BASE64=
APPLE_STORE_ROOT_CERTIFICATE_SHA256=
STORE_BILLING_ACCOUNT_BINDING_KEY=

OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.6-sol
OPENROUTER_PROJECT_MODEL=openai/gpt-5.6-sol
OPENROUTER_FALLBACK_MODELS=openai/gpt-5.6-sol,openai/gpt-5.6-terra,openai/gpt-5.6-luna
OPENROUTER_ALLOWED_MODELS=openai/gpt-5.6-sol,openai/gpt-5.6-terra,openai/gpt-5.6-luna
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_PROVIDER_SORT=latency
OPENROUTER_PROVIDER_DATA_COLLECTION=allow
OPENROUTER_PROVIDER_ZDR=false
OPENROUTER_WEB_SEARCH_ENABLED=true
OPENROUTER_WEB_SEARCH_MAX_RESULTS=3
OPENROUTER_WEB_SEARCH_MAX_TOTAL_RESULTS=5
OPENROUTER_MAX_TOKENS=800
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_CONNECT_TIMEOUT_SECONDS=5
OPENROUTER_CIRCUIT_FAILURE_THRESHOLD=3
OPENROUTER_CIRCUIT_OPEN_SECONDS=30
OPENROUTER_BILLING_CIRCUIT_OPEN_SECONDS=900
OPENROUTER_GLOBAL_DAILY_REQUEST_LIMIT=5000
OPENROUTER_GLOBAL_DAILY_TOKEN_BUDGET=2100000
OPENROUTER_GLOBAL_MONTHLY_TOKEN_BUDGET=50000000
OPENROUTER_CHAT_HISTORY_DAYS=90
OPENROUTER_PDF_PARSER_ENGINE=cloudflare-ai
OPENROUTER_ATTACHMENT_PROVIDER_MAX_BYTES=8388608
OPENROUTER_RESPONSE_RECOVERY_CACHE_TTL_SECONDS=900
# Finance must calibrate this from net package receipts after gateway fees,
# taxes and FX. Production preflight fails while it is blank or non-positive.
ROKN_NET_USD_PER_PAID_COIN=
# Must cover provider price movement, retries and normal usage variance.
ROKN_AI_COST_SAFETY_MULTIPLIER=2.0
# Must stay above the accepted queue delay and provider timeout.
ROKN_AI_RESERVATION_TTL_SECONDS=1200
ROKN_AI_UNANSWERED_PROVIDER_REQUEST_LIMIT=4
ROKN_AI_UNANSWERED_PROVIDER_WINDOW_SECONDS=600
ROKN_AI_PROVIDER_EXPOSURE_COOLDOWN_SECONDS=300

# Keep the intended product set explicit. The initial direct Android launch
# does not advertise Apple before its account and identifiers are ready; add
# `apple` here in the release that enables that sign-in method.
SOCIAL_AUTH_PROVIDERS=google,tiktok,facebook
SOCIAL_AUTH_RECOMMENDED_PROVIDER=google
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Required: set the currently supported Meta Graph API version explicitly.
FACEBOOK_GRAPH_VERSION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CONNECT_TIMEOUT_SECONDS=3
GOOGLE_TIMEOUT_SECONDS=8
GOOGLE_MAPS_BROWSER_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_USER_INFO_URL=https://open.tiktokapis.com/v2/user/info/
SOCIAL_AUTH_PUBLIC_API_URL=https://api.example.com/api/v1
SOCIAL_AUTH_RETURN_URLS=rokn://auth
SOCIAL_AUTH_TIMEOUT_SECONDS=10
ACCOUNT_DELETION_REAUTH_SECONDS=300
# Required in production: stable random HMAC key, never a provider ID or user datum.
REWARD_TOMBSTONE_HMAC_KEY=
WELCOME_BONUS_COINS=20

# Path to a secret mounted outside the repository.
FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json
# Managed hosts without secret-file mounts can inject the same service-account
# JSON as strict base64 instead. Configure one source, not both.
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_CACHE_STORE=redis

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Rokn

# WhatsApp account-linking bot. The provider posts inbound messages to
# /api/v1/whatsapp/webhook with X-WhatsApp-Webhook-Secret.
WHATSAPP_LINKING_ENABLED=false
WHATSPIE_API_URL=
WHATSPIE_API_KEY=
WHATSPIE_DEVICE=
WHATSPIE_CONNECT_TIMEOUT_SECONDS=5
WHATSPIE_TIMEOUT_SECONDS=15
WHATSAPP_BOT_PHONE=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_LINK_TOKEN_MINUTES=30

PROJECT_FALLBACK_REVIEW_DELAY_SECONDS=90
PROJECT_MAXIMUM_FILE_KILOBYTES=25600

# Fixture seeders reject production even if this value is changed. Keep it
# false so an accidental seed command fails before touching data.
ROKN_SEED_DEMO=false
APPLE_CLIENT_ID=
LEARNING_MINIMUM_VERIFIED_SECONDS=20
LEARNING_REQUIRED_WATCH_FRACTION=0.80
LEARNING_MAXIMUM_PLAYBACK_RATE=2.0
LEARNING_MAXIMUM_HEARTBEAT_GAP_SECONDS=45
