{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4.24",
        "ext-curl": "*",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "endroid/qr-code": "^6.0",
        "firebase/php-jwt": "^7.0.3",
        "google/apiclient": "^2.19",
        "guzzlehttp/guzzle": "^7.8.2",
        "intervention/image": "^2.7",
        "jenssegers/agent": "^2.6.4",
        "khaled.alshamaa/ar-php": "^7.0",
        "kreait/firebase-php": "^7.24.1",
        "laravel/framework": "^12.61.1",
        "laravel/nightwatch": "^1.30",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6.3",
        "league/flysystem-aws-s3-v3": "^3.25",
        "mpdf/mpdf": "^8.2.6",
        "nesbot/carbon": "^3.8.4",
        "pusher/pusher-php-server": "^7.2",
        "rokn/form-compat": "^1.0",
        "sentry/sentry-laravel": "^4.27",
        "zircote/swagger-php": "^4.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.8.3",
        "phpunit/phpunit": "^11.5.56",
        "spatie/laravel-ignition": "^2.12"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/rokn/form-compat",
            "options": {
                "symlink": false
            }
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.24"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/functions.php"
        ],
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "verify:secrets": [
            "@php scripts/verify-repository-secrets.php --history"
        ],
        "test:filter": [
            "@php vendor/bin/phpunit --filter"
        ]
    }
}
