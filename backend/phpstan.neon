# Static analysis for the doctrine in ../ARCHITECTURE.md.
# Larastan (https://github.com/larastan/larastan) understands Laravel's magic;
# phpstan-disallowed-calls (https://github.com/spaze/phpstan-disallowed-calls)
# enforces rule B1: controllers delegate, services own transactions and locks.
# phpstan-baseline.neon holds pre-existing findings and may only shrink.

includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
    tmpDir: storage/framework/phpstan
    reportUnmatchedIgnoredErrors: true

    disallowedStaticCalls:
        -
            method:
                - 'Illuminate\Validation\Factory::make()'
                - 'Illuminate\Support\Facades\Validator::make()'
            message: 'dashboard input validation belongs to FormRequests or Filament schemas (ARCHITECTURE.md D2)'
            disallowIn:
                - app/Http/Controllers/Admin/*
        -
            method:
                - 'Illuminate\Database\Eloquent\Model::*()'
                - 'Illuminate\Database\Connection::select()'
                - 'Illuminate\Database\Connection::table()'
            message: 'dashboard controllers delegate database reads to the owning read service (ARCHITECTURE.md B1)'
            disallowIn:
                - app/Http/Controllers/Admin/TeacherController.php
                - app/Http/Controllers/Admin/PathController.php
                - app/Http/Controllers/Admin/ClassificationController.php
                - app/Http/Controllers/Admin/LevelController.php
                - app/Http/Controllers/Admin/PackageController.php
                - app/Http/Controllers/Admin/CouponController.php
        # Larastan resolves the DB facade to Illuminate\Database\Connection.
        -
            method:
                - 'Illuminate\Database\Connection::transaction()'
                - 'Illuminate\Database\Connection::beginTransaction()'
            message: 'controllers delegate; transactions live in the owning service (ARCHITECTURE.md B1)'
            disallowIn:
                - app/Http/Controllers/*

    disallowedMethodCalls:
        -
            method:
                - 'Illuminate\Http\Request::validate()'
                - 'Illuminate\Http\Request::validateWithBag()'
                - 'Illuminate\Validation\Factory::make()'
            message: 'dashboard input validation belongs to FormRequests or Filament schemas (ARCHITECTURE.md D2)'
            disallowIn:
                - app/Http/Controllers/Admin/*
        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::*()'
                - 'Illuminate\Database\Query\Builder::*()'
                - 'Illuminate\Database\Eloquent\Relations\Relation::*()'
            message: 'dashboard controllers delegate database reads to the owning read service (ARCHITECTURE.md B1)'
            disallowIn:
                - app/Http/Controllers/Admin/TeacherController.php
                - app/Http/Controllers/Admin/PathController.php
                - app/Http/Controllers/Admin/ClassificationController.php
                - app/Http/Controllers/Admin/LevelController.php
                - app/Http/Controllers/Admin/PackageController.php
                - app/Http/Controllers/Admin/CouponController.php
        -
            method:
                - 'Illuminate\Database\Eloquent\Builder::lockForUpdate()'
                - 'Illuminate\Database\Query\Builder::lockForUpdate()'
                - 'Illuminate\Database\Eloquent\Builder::sharedLock()'
                - 'Illuminate\Database\Query\Builder::sharedLock()'
            message: 'controllers delegate; locks live in the owning service (ARCHITECTURE.md B1, B4)'
            disallowIn:
                - app/Http/Controllers/*
