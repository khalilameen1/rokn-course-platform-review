# Public build-time configuration. Do not put secrets in this file.
# Use the deployed Laravel API URL, including its versioned /api/v1/ suffix.
EXPO_PUBLIC_API_URL=https://rokn.app/api/v1/

# Optional public OAuth client ids. When they are absent or the native bridge
# cannot use them, Google continues automatically through the backend-owned
# browser PKCE flow. Never put a Google client secret here.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web-oauth-client>.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<ios-oauth-client>.apps.googleusercontent.com

# Facebook stays on browser PKCE until both its native SDK and public client
# token are configured in the native projects. The backend app secret never
# belongs in the mobile build.

# Public portfolio route used by local/demo certificates. Production profiles
# and certificate QR links are returned authoritatively by the Laravel API.
EXPO_PUBLIC_PORTFOLIO_URL=https://rokn.app

# Distribution and build profile are injected by release automation.
# Valid channels: direct, play, appstore. Only direct may start web checkout.
# Do not set EXPO_PUBLIC_DISTRIBUTION_CHANNEL or EXPO_PUBLIC_BUILD_PROFILE here.
# Production profiles set EXPO_PUBLIC_REQUIRE_FEATURE_FLAGS=1 so new payment,
# upload and AI mutations fail closed if feature control is unavailable.

# Public pages entered in Play Console / App Store Connect and opened from
# Settings. They must stay reachable without signing in.
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://rokn.app/account-deletion

# Runtime crash diagnostics. The DSN is a public client key; source-map upload
# credentials remain build secrets and must be injected by CI/EAS.
# EXPO_PUBLIC_SENTRY_DSN=https://<public-key>@<host>/<project-id>
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_ORG=<organization-slug>
# SENTRY_PROJECT=<project-slug>
# SENTRY_AUTH_TOKEN=<ci-only-source-map-token>

# Optional. When omitted, the app reads the support number from the backend.
# EXPO_PUBLIC_SUPPORT_WHATSAPP_URL=https://wa.me/<international-number>

# To produce signed output, keep these secrets outside the repository in
# %USERPROFILE%\.gradle\gradle.properties (or inject them in CI):
# UPLOAD_STORE_FILE=C:/secure/rokn-upload.keystore
# UPLOAD_STORE_PASSWORD=...
# UPLOAD_KEY_ALIAS=...
# UPLOAD_KEY_PASSWORD=...
