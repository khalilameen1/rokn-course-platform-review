<resources>

    <!--
      Keep the AppCompat parent on a uniquely named base style. Android picks
      the most specific values-vNN declaration as a complete style; declaring
      AppTheme without a parent in values-v27/v29 therefore dropped AppCompat
      on modern phones and crashed before React Native could mount.
    -->
    <style name="RoknBaseTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme" parent="RoknBaseTheme" />

    <!-- Expo's native owner retains Android's launch surface until React's
         first content frame. Keep the existing full Rokn wordmark artwork. -->
    <style name="RoknLaunchBaseTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rokn_startup_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splashscreen_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="RoknLaunchTheme" parent="RoknLaunchBaseTheme" />

</resources>
