{
  "expo": {
    "name": "Rokn",
    "slug": "rokn",
    "version": "1.0.63",
    "icon": "./src/assets/images/brand/rokn-app-icon-1024.png",
    "orientation": "default",
    "scheme": "rokn",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-notifications",
        {
          "color": "#2C69DB",
          "defaultChannel": "rokn-updates"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/brand/rokn-startup-brand.png",
          "imageWidth": 205,
          "android": {
            "image": "./src/assets/images/brand/rokn-startup-brand-android.png",
            "imageWidth": 192
          },
          "resizeMode": "contain",
          "backgroundColor": "#0B1628"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "./plugins/withNotificationManifestOverrides",
      "expo-iap",
      "@sentry/react-native"
    ],
    "android": {
      "package": "com.rokn",
      "versionCode": 65,
      "googleServicesFile": "./android/app/google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {"scheme": "https"},
            {"host": "rokn.app"},
            {"path": "/home"},
            {"path": "/profile"},
            {"path": "/wallet"},
            {"path": "/contact"},
            {"pathPrefix": "/support/"},
            {"pathPrefix": "/course/"}
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {"scheme": "https"},
            {"host": "www.rokn.app"},
            {"path": "/home"},
            {"path": "/profile"},
            {"path": "/wallet"},
            {"path": "/contact"},
            {"pathPrefix": "/support/"},
            {"pathPrefix": "/course/"}
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/brand/rokn-app-icon-foreground.png",
        "monochromeImage": "./src/assets/images/brand/rokn-app-icon-foreground.png",
        "backgroundColor": "#2C69DB"
      }
    },
    "ios": {
      "bundleIdentifier": "com.rokn",
      "buildNumber": "54",
      "googleServicesFile": "./ios/GoogleService-Info.plist",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "NSPhotoLibraryUsageDescription": "لاختيار صورة للحساب أو المشروع",
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "associatedDomains": ["applinks:rokn.app", "applinks:www.rokn.app"]
    }
  }
}
