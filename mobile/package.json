{
  "name": "Rokn",
  "version": "1.0.40",
  "private": true,
  "main": "index.js",
  "packageManager": "npm@10.9.3",
  "scripts": {
    "postinstall": "node scripts/apply-rnfirebase-ios-constants-fix.js",
    "android": "node scripts/run-android.js",
    "apk": "npm run apk:test",
    "apk:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-release.ps1 -Channel direct -Profile test -Artifact apk",
    "apk:direct": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-release.ps1 -Channel direct -Profile production -Artifact apk",
    "apk:play": "npm run aab:play",
    "aab:play": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-release.ps1 -Channel play -Profile production -Artifact aab",
    "android:install-artifact": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-android-artifact.ps1",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "lint:release": "eslint App.tsx index.js \"src/**/*.{js,jsx,ts,tsx}\" \"__tests__/**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "test": "jest",
    "test:release": "node scripts/run-release-tests.js",
    "test:release-scripts": "node --test scripts/tests/bundled-font-notices.test.js scripts/tests/gradle-dependency-provenance.test.js scripts/tests/mobile-ci-provenance.test.js scripts/tests/native-third-party-notices.test.js scripts/tests/notification-manifest-plugin.test.js scripts/tests/production-entry-smoke.test.js scripts/tests/react-native-firebase-ios-compatibility.test.js scripts/tests/react-native-toolchain-alignment.test.js scripts/tests/repository-secret-scanner.test.js scripts/tests/staging-api-contract.test.js scripts/tests/third-party-notices.test.js",
    "notices:generate": "node scripts/generate-third-party-notices.js",
    "notices:android:generate": "node scripts/generate-native-third-party-notices.js --android-only",
    "notices:native:generate": "node scripts/generate-native-third-party-notices.js",
    "licenses:check": "node scripts/generate-third-party-notices.js --check",
    "licenses:android:check": "node scripts/generate-native-third-party-notices.js --android-only --check",
    "licenses:native:check": "node scripts/generate-native-third-party-notices.js --check",
    "licenses:native:portable-check": "node scripts/generate-native-third-party-notices.js --check --portable-check",
    "audit:release": "node scripts/audit-production-dependencies.js",
    "audit:a11y": "node scripts/audit-accessibility.js",
    "eas-build-post-install": "npm run verify:release",
    "eas-build-on-success": "node scripts/eas-build-on-success.js",
    "e2e:android:staging": "node scripts/run-android-staging-smoke.js",
    "e2e:android:production-entry": "node scripts/run-android-production-entry-smoke.js",
    "verify:staging-api": "node scripts/verify-staging-api-contract.js",
    "verify:provenance": "node scripts/verify-artifact-provenance.js",
    "verify:config": "node scripts/verify-release-config.js",
    "verify:expo-dependencies": "expo install --check",
    "verify:ios-lock": "node scripts/verify-ios-pod-lock.js",
    "verify:secrets": "node scripts/verify-repository-secrets.js --history",
    "typecheck": "tsc --noEmit --pretty false",
    "verify:release": "npm run verify:config && npm run verify:secrets && npm run verify:expo-dependencies && npm run test:release-scripts && npm run licenses:check && npm run licenses:native:portable-check && npm run typecheck && npm run lint:release && npm run test:release && npm run audit:a11y && npm run audit:release"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-firebase/app": "26.3.2",
    "@react-native-firebase/messaging": "26.3.2",
    "@react-native-google-signin/google-signin": "16.1.2",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/react-native": "~7.11.0",
    "axios": "1.19.0",
    "expo": "~55.0.31",
    "expo-apple-authentication": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-document-picker": "~55.0.17",
    "expo-iap": "^5.4.1",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-web-browser": "~55.0.20",
    "i18next": "^25.7.3",
    "js-sha256": "1.0.0",
    "react": "19.2.0",
    "react-i18next": "^16.5.0",
    "react-native": "0.83.10",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^4.2.1",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-restart": "^0.0.27",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.23.0",
    "react-native-share": "^12.2.1",
    "react-native-svg": "15.15.3",
    "react-native-video": "^6.18.0",
    "react-native-worklets": "0.7.4",
    "react-redux": "^9.2.0",
    "toqr": "^0.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@expo/config-plugins": "55.0.11",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@types/jest": "^29.5.13",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "browserslist": "4.28.8",
    "metro": "0.83.8",
    "metro-config": "0.83.8",
    "metro-transform-worker": "0.83.8",
    "nanoid": "3.3.18",
    "uuid": "11.1.1"
  },
  "resolutions": {
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
